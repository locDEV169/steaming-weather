FROM alpine:3.20

RUN apk add --no-cache curl

COPY scripts/cron_current_weather.sh /usr/local/bin/cron_current_weather.sh
COPY scripts/cron_ingest.sh /usr/local/bin/cron_ingest.sh
COPY scripts/docker_cron_entrypoint.sh /usr/local/bin/docker_cron_entrypoint.sh
# Strip CRLF if host checkout still has Windows line endings.
RUN sed -i 's/\r$//' /usr/local/bin/cron_current_weather.sh \
      /usr/local/bin/cron_ingest.sh \
      /usr/local/bin/docker_cron_entrypoint.sh \
  && chmod +x /usr/local/bin/cron_current_weather.sh \
      /usr/local/bin/cron_ingest.sh \
      /usr/local/bin/docker_cron_entrypoint.sh

CMD ["/usr/local/bin/docker_cron_entrypoint.sh"]
