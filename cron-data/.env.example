WEATHER_API_HOST=127.0.0.1
WEATHER_API_PORT=5000
# Comma-separated origins, or * for any origin.
CORS_ORIGINS=*
WEATHER_API_KEY=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Fallback location when ?location= is omitted (ingest/snapshots/lifestyle).
# Enum: da_nang (default) | sai_gon — same registry as current-weather.
SUPABASE_LOCATION_KEY=da_nang

# Telegram Bot API for POST /api/v1/current-weather
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Gunicorn (Docker weather-api). Defaults in Dockerfile: workers=2, timeout=120.
# GUNICORN_WORKERS=2
# GUNICORN_TIMEOUT=120

# Docker sidecar cron (compose service current-weather-cron)
CURRENT_WEATHER_CRON_SCHEDULE=0 * * * *
CURRENT_WEATHER_CRON_LOCATIONS=da_nang,sai_gon
CURRENT_WEATHER_CRON_GAP_SEC=2
CURRENT_WEATHER_CRON_MAX_ATTEMPTS=2
# Snapshot ingest (:05 default to stagger from current-weather :00)
INGEST_CRON_SCHEDULE=5 * * * *
INGEST_CRON_LOCATIONS=da_nang,sai_gon
INGEST_CRON_GAP_SEC=2
INGEST_CRON_MAX_ATTEMPTS=2
# WEATHER_API_BASE_URL is set by compose to http://weather-api:7500

DATABASE_URL=
