WEATHER_API_HOST=127.0.0.1
WEATHER_API_PORT=5000
# Comma-separated origins, or * for any origin.
CORS_ORIGINS=*
WEATHER_API_KEY=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Default location for snapshot/lifestyle paths. current-weather uses ?location=
# enum instead: da_nang (default) | sai_gon
SUPABASE_LOCATION_KEY=da_nang

# Telegram Bot API for POST /api/v1/current-weather
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Gunicorn (Docker weather-api). Defaults in Dockerfile: workers=2, timeout=120.
# GUNICORN_WORKERS=2
# GUNICORN_TIMEOUT=120

# Docker sidecar current-weather-cron (compose service)
CURRENT_WEATHER_CRON_SCHEDULE=0 * * * *
CURRENT_WEATHER_CRON_LOCATIONS=da_nang,sai_gon
CURRENT_WEATHER_CRON_GAP_SEC=2
CURRENT_WEATHER_CRON_MAX_ATTEMPTS=2
WEATHER_API_BASE_URL is set by compose to http://weather-api:7500

DATABASE_URL=
