  "/api/v1/air-quality": {
    "get": {
      "summary": "Get current European AQI for Da Nang",
      "description": "Fetches current air quality from Open-Meteo Air Quality API and returns the provider payload plus additive results.overall (band from european_aqi) and results.summary (bilingual UI copy). When hourly or current uv_index is present, the hourly series is kept and results.uv is the WHO band for the current UV value. No US AQI, no per-pollutant assessment. Summary text is informational band copy for display, not clinical advice. API key auth is optional and only enforced when WEATHER_API_KEY is set.",
      "operationId": "getAirQuality",
      "tags": [
        "weather_related"
      ],
      "security": [
        {},
        {
          "ApiKeyAuth": []
        },
        {
          "BearerAuth": []
        }
      ],
      "responses": {
        "200": {
          "description": "Air quality retrieved successfully.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AirQuality"
              }
            }
          }
        },
        "401": {
          "description": "Missing or invalid API key when WEATHER_API_KEY is configured.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApiErrorResponse"
              }
            }
          }
        },
        "500": {
          "description": "Unhandled server error.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApiErrorResponse"
              }
            }
          }
        },
        "502": {
          "description": "The air quality provider returned an error or an invalid response.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApiErrorResponse"
              }
            }
          }
        },
        "504": {
          "description": "The air quality provider timed out.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApiErrorResponse"
              }
            }
          }
        }
      }
    }
  },
  "/api/v1/snapshots/{slug}": {
    "get": {
      "summary": "Get a persisted Supabase weather snapshot",
      "description": "Reads the latest weather_snapshots row for the requested location and returns its payload only (same shape as the matching live endpoint). Query param location is da_nang (default) or sai_gon. Slug is weather | rainny | air-quality. Does not call Open-Meteo. Requires prior POST /api/v1/ingest for that location. API key auth is optional when WEATHER_API_KEY is set.",
      "operationId": "getWeatherSnapshot",
      "tags": [
        "snapshots"
      ],
      "security": [
        {},
        {
          "ApiKeyAuth": []
        },
        {
          "BearerAuth": []
        }
      ],
      "parameters": [
        {
          "name": "slug",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "enum": [
              "weather",
              "rainny",
              "air-quality"
            ]
          }
        },
        {
          "name": "location",
          "in": "query",
          "required": false,
          "description": "Location key. Defaults to da_nang when omitted.",
          "schema": {
            "type": "string",
            "enum": [
              "da_nang",
              "sai_gon"
            ],
            "default": "da_nang"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Snapshot payload returned successfully.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true
              }
            }
          }
        },
        "400": {
          "description": "Invalid snapshot slug or location.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApiErrorResponse"
              }
            }
          }
        },
        "401": {
          "description": "Missing or invalid API key when WEATHER_API_KEY is configured.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApiErrorResponse"
              }
            }
          }
        },
        "404": {
          "description": "No snapshot row for that kind/location.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApiErrorResponse"
              }
            }
          }
        },
        "502": {
          "description": "Supabase read failed.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApiErrorResponse"
              }
            }
          }
        },
        "503": {
          "description": "Supabase is not configured.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApiErrorResponse"
              }
            }
          }
        }
      }
    }
  },
  "/api/v1/ingest": {
    "post": {
      "summary": "Ingest shaped snapshots into Supabase",
      "description": "Fetches Open-Meteo weather and air quality for the requested location (da_nang default, or sai_gon), shapes rainny and AQ results, and upserts latest-only rows into weather_snapshots keyed by (location_key, kind). Coords come from the same location registry as current-weather. Requires WEATHER_API_KEY and Supabase service role env. Partial per-kind updates are allowed.",
      "operationId": "postWeatherIngest",
      "tags": [
        "ingest"
      ],
      "security": [
        {
          "ApiKeyAuth": []
        },
        {
          "BearerAuth": []
        }
      ],
      "parameters": [
        {
          "name": "location",
          "in": "query",
          "required": false,
          "description": "Location key. Defaults to da_nang when omitted.",
          "schema": {
            "type": "string",
            "enum": [
              "da_nang",
              "sai_gon"
            ],
            "default": "da_nang"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "At least one snapshot kind was updated.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "ok",
                  "location_key",
                  "fetched_at",
                  "updated",
                  "results"
                ],
                "properties": {
                  "ok": {
                    "type": "boolean",
                    "example": true
                  },
                  "location_key": {
                    "type": "string",
                    "example": "da_nang"
                  },
                  "fetched_at": {
                    "type": "string",
                    "example": "2026-11-04T04:00:00+00:00"
                  },
                  "updated": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "example": [
                      "weather",
                      "rainny",
                      "air_quality"
                    ]
                  },
                  "results": {
                    "type": "object",
                    "additionalProperties": true
                  }
                }
              }
            }
          }
        },
        "400": {
          "description": "Invalid location query param.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApiErrorResponse"
              }
            }
          }
        },
        "401": {
          "description": "Missing or invalid API key.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApiErrorResponse"
              }
            }
          }
        },
        "502": {
          "description": "No snapshot kinds were updated.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApiErrorResponse"
              }
            }
          }
        },
        "503": {
          "description": "Ingest auth or Supabase is not configured.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApiErrorResponse"
              }
            }
          }
        }
      }
    }
  },
  "/api/v1/ingest-all": {
    "post": {
      "summary": "Ingest snapshots for all registry locations",
      "description": "Runs the same snapshot ingest as POST /api/v1/ingest once per registered location (da_nang then sai_gon). One HTTP call covers both cities. Partial per-location success is allowed: HTTP 200 if at least one location updated. Requires WEATHER_API_KEY and Supabase service role env. Prefer this for manual/Swagger seed; production cron may still POST /api/v1/ingest per location.",
      "operationId": "postWeatherIngestAll",
      "tags": [
        "ingest"
      ],
      "security": [
        {
          "ApiKeyAuth": []
        },
        {
          "BearerAuth": []
        }
      ],
      "responses": {
        "200": {
          "description": "At least one location had a successful kind update.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "ok",
                  "locations",
                  "updated_locations",
                  "results_by_location"
                ],
                "properties": {
                  "ok": {
                    "type": "boolean",
                    "example": true
                  },
                  "locations": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "example": [
                      "da_nang",
                      "sai_gon"
                    ]
                  },
                  "updated_locations": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "example": [
                      "da_nang",
                      "sai_gon"
                    ]
                  },
                  "results_by_location": {
                    "type": "object",
                    "additionalProperties": true,
                    "description": "Per-location bodies matching POST /api/v1/ingest."
                  }
                }
              }
            }
          }
        },
        "401": {
          "description": "Missing or invalid API key.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApiErrorResponse"
              }
            }
          }
        },
        "502": {
          "description": "No location updated any snapshot kind.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApiErrorResponse"
              }
            }
          }
        },
        "503": {
          "description": "Ingest auth or Supabase is not configured.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApiErrorResponse"
              }
            }
          }
        }
      }
    }
  },
  "/api/v1/current-weather": {
    "get": {
      "summary": "Read the latest stored current weather",
      "description": "Reads the newest current_weather row for the requested location from Supabase (order by fetched_at desc). Query param location is an enum: da_nang (default) or sai_gon. Returns id, location_key, fetched_at, and the stored payload (Open-Meteo current fields plus optional WMO evaluation). Does not call Open-Meteo, does not insert, and does not send Telegram. API key auth is optional and only enforced when WEATHER_API_KEY is set.",
      "operationId": "getCurrentWeather",
      "tags": [
        "current-weather"
      ],
      "security": [
        {
          "ApiKeyAuth": []
        },
        {
          "BearerAuth": []
        }
      ],
      "parameters": [
        {
          "name": "location",
          "in": "query",
          "required": false,
          "description": "Location key. Defaults to da_nang when omitted.",
          "schema": {
            "type": "string",
            "enum": [
              "da_nang",
              "sai_gon"
            ],
            "default": "da_nang"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Latest stored current_weather row.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CurrentWeatherStored"
              }
            }
          }
        },
        "400": {
          "description": "Invalid location query param.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApiErrorResponse"
              }
            }
          }
        },
        "401": {
          "description": "Missing or invalid API key.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApiErrorResponse"
              }
            }
          }
        },
        "404": {
          "description": "No current_weather row is stored yet for the location.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApiErrorResponse"
              }
            }
          }
        },
        "502": {
          "description": "Supabase read failed.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApiErrorResponse"
              }
            }
          }
        },
        "503": {
          "description": "Supabase is not configured.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApiErrorResponse"
              }
            }
          }
        }
      }
    },
    "post": {
      "summary": "Fetch current weather, insert Supabase, notify Telegram",
      "description": "Fetches Open-Meteo current weather for the requested location (da_nang default; sai_gon uses 10.762622, 106.660172), shapes the payload, attaches Key WMO evaluation when weather_code maps, inserts a new append-only current_weather row, then sends a Telegram message. Requires WEATHER_API_KEY, Supabase service role env, TELEGRAM_BOT_TOKEN, and TELEGRAM_CHAT_ID.",
      "operationId": "postCurrentWeather",
      "tags": [
        "current-weather"
      ],
      "security": [
        {
          "ApiKeyAuth": []
        },
        {
          "BearerAuth": []
        }
      ],
      "parameters": [
        {
          "name": "location",
          "in": "query",
          "required": false,
          "description": "Location key. Defaults to da_nang when omitted.",
          "schema": {
            "type": "string",
            "enum": [
              "da_nang",
              "sai_gon"
            ],
            "default": "da_nang"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Current weather was inserted and Telegram was notified.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CurrentWeatherReportResponse"
              }
            }
          }
        },
        "400": {
          "description": "Invalid location query param.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApiErrorResponse"
              }
            }
          }
        },
        "401": {
          "description": "Missing or invalid API key.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApiErrorResponse"
              }
            }
          }
        },
        "502": {
          "description": "Upstream, Supabase write, or Telegram send failed.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApiErrorResponse"
              }
            }
          }
        },
        "503": {
          "description": "API key, Supabase, or Telegram is not configured.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApiErrorResponse"
              }
            }
          }
        },
        "504": {
          "description": "Open-Meteo timed out.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApiErrorResponse"
              }
            }
          }
        }
      }
    }
  },
  "/api/v1/lifestyle-insights": {
    "get": {
      "summary": "Read the latest lifestyle context forecast",
      "description": "Reads the lifestyle_insights row with the greatest fetched_at. Laundry and car wash use the first 3 stored hours from as_of. A laundry hour with precipitation probability >= 40 or precipitation >= 0.2 mm has flag Nguy cơ ướt. laundry.score is 100 minus the mean of those three probabilities, null as 0. laundry.message is the matching catalog sentence. car_wash.mean is that same mean. When the mean is inside one level score_min and score_max, car_wash.message is that level message. A null score_min counts as 0. No workout score. Does not call Open-Meteo. API key auth is optional and only enforced when WEATHER_API_KEY is set.",
      "operationId": "getLifestyleInsight",
      "tags": [
        "lifestyle-insights"
      ],
      "security": [
        {
          "ApiKeyAuth": []
        },
        {
          "BearerAuth": []
        }
      ],
      "responses": {
        "200": {
          "description": "Latest stored lifestyle row, the first 3 hours from as_of, and the car-wash mean.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "fetched_at",
                  "laundry",
                  "car_wash"
                ],
                "properties": {
                  "id": {
                    "type": "integer"
                  },
                  "location_key": {
                    "type": "string"
                  },
                  "fetched_at": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "as_of": {
                    "type": "string"
                  },
                  "laundry": {
                    "type": "object",
                    "additionalProperties": true
                  },
                  "car_wash": {
                    "type": "object",
                    "additionalProperties": true,
                    "nullable": true
                  }
                }
              }
            }
          }
        },
        "401": {
          "description": "Missing or invalid API key.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApiErrorResponse"
              }
            }
          }
        },
        "404": {
          "description": "No lifestyle row is stored.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApiErrorResponse"
              }
            }
          }
        },
        "502": {
          "description": "Supabase read failed.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApiErrorResponse"
              }
            }
          }
        },
        "503": {
          "description": "Supabase is not configured.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApiErrorResponse"
              }
            }
          }
        }
      }
    },
    "post": {
      "summary": "Append one lifestyle context forecast",
      "description": "Fetches Open-Meteo and inserts one append-only row into lifestyle_insights. Hour labels on the new row are UTC. Each new hour stores apparent_temperature from that hour. The 72-hour series keeps provider wind in km/h. Current may also include apparent_temperature when the provider sends it. Does not write weather_snapshots and does not run snapshot ingest. Requires WEATHER_API_KEY and Supabase service role env.",
      "operationId": "postLifestyleInsight",
      "tags": [
        "lifestyle-insights"
      ],
      "security": [
        {
          "ApiKeyAuth": []
        },
        {
          "BearerAuth": []
        }
      ],
      "responses": {
        "201": {
          "description": "One lifestyle history row was inserted.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "ok",
                  "location_key",
                  "fetched_at",
                  "as_of",
                  "hours_returned"
                ],
                "properties": {
                  "ok": {
                    "type": "boolean",
                    "example": true
                  },
                  "id": {
                    "type": "integer",
                    "example": 1
                  },
                  "location_key": {
                    "type": "string",
                    "example": "da_nang"
                  },
                  "fetched_at": {
                    "type": "string",
                    "example": "2026-11-04T04:00:00+00:00"
                  },
                  "as_of": {
                    "type": "string",
                    "example": "2026-11-04T10:00"
                  },
                  "hours_returned": {
                    "type": "integer",
                    "example": 72
                  }
                }
              }
            }
          }
        },
        "401": {
          "description": "Missing or invalid API key.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApiErrorResponse"
              }
            }
          }
        },
        "502": {
          "description": "Upstream or Supabase write failed.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApiErrorResponse"
              }
            }
          }
        },
        "503": {
          "description": "API key or Supabase is not configured.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApiErrorResponse"
              }
            }
          }
        },
        "504": {
          "description": "Open-Meteo timed out.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApiErrorResponse"
              }
            }
          }
        }
      }
    }
  }
}
