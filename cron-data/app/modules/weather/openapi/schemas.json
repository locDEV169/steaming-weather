{
  "WeatherForecast": {
    "type": "object",
    "required": [
      "current",
      "hourly",
      "daily"
    ],
    "properties": {
      "latitude": {
        "type": "number",
        "example": 16.063269
      },
      "longitude": {
        "type": "number",
        "example": 108.23864
      },
      "timezone": {
        "type": "string",
        "example": "Asia/Bangkok"
      },
      "current": {
        "type": "object",
        "additionalProperties": true
      },
      "hourly": {
        "type": "object",
        "additionalProperties": true
      },
      "daily": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "additionalProperties": true
  },
  "AirQualityOverallResult": {
    "type": "object",
    "required": [
      "index",
      "band_code",
      "label_key"
    ],
    "properties": {
      "index": {
        "type": "number",
        "example": 32
      },
      "band_code": {
        "type": "string",
        "enum": [
          "good",
          "fair",
          "moderate",
          "poor",
          "very_poor",
          "extremely_poor"
        ],
        "example": "fair"
      },
      "label_key": {
        "type": "string",
        "example": "aqi.european.fair"
      }
    }
  },
  "AirQualitySummary": {
    "type": "object",
    "required": [
      "band_code",
      "level_vi",
      "level_en",
      "meaning_vi",
      "meaning_en"
    ],
    "properties": {
      "band_code": {
        "type": "string",
        "enum": [
          "good",
          "fair",
          "moderate",
          "poor",
          "very_poor",
          "extremely_poor"
        ],
        "example": "fair"
      },
      "level_vi": {
        "type": "string",
        "example": "Tốt"
      },
      "level_en": {
        "type": "string",
        "example": "Fair"
      },
      "meaning_vi": {
        "type": "string",
        "example": "Không khí sạch, an toàn cho đại đa số người dân."
      },
      "meaning_en": {
        "type": "string",
        "example": "Air is clean and safe for the vast majority of people."
      }
    }
  },
  "AirQualityResults": {
    "type": "object",
    "required": [
      "scale",
      "band_table_version",
      "source",
      "overall",
      "summary"
    ],
    "properties": {
      "scale": {
        "type": "string",
        "example": "european_aqi"
      },
      "band_table_version": {
        "type": "string",
        "example": "open-meteo-eea-2024"
      },
      "source": {
        "type": "string",
        "example": "https://open-meteo.com/en/docs/air-quality-api"
      },
      "overall": {
        "$ref": "#/components/schemas/AirQualityOverallResult"
      },
      "summary": {
        "$ref": "#/components/schemas/AirQualitySummary"
      },
      "uv": {
        "$ref": "#/components/schemas/UvIndexSummary"
      }
    }
  },
  "UvIndexSummary": {
    "type": "object",
    "description": "WHO global solar UV index band for the current hour. Omitted when uv_index is absent.",
    "required": [
      "index",
      "band_code",
      "level_vi",
      "level_en",
      "meaning_vi",
      "meaning_en"
    ],
    "properties": {
      "index": {
        "type": "number",
        "example": 4.2
      },
      "band_code": {
        "type": "string",
        "enum": [
          "low",
          "moderate",
          "high",
          "very_high",
          "extreme"
        ],
        "example": "moderate"
      },
      "level_vi": {
        "type": "string",
        "example": "Trung bình"
      },
      "level_en": {
        "type": "string",
        "example": "Moderate"
      },
      "meaning_vi": {
        "type": "string"
      },
      "meaning_en": {
        "type": "string"
      }
    }
  },
  "AirQuality": {
    "type": "object",
    "required": [
      "current",
      "results"
    ],
    "properties": {
      "latitude": {
        "type": "number",
        "example": 16.0544
      },
      "longitude": {
        "type": "number",
        "example": 108.2022
      },
      "timezone": {
        "type": "string",
        "example": "Asia/Bangkok"
      },
      "current": {
        "type": "object",
        "required": [
          "european_aqi"
        ],
        "properties": {
          "time": {
            "type": "string",
            "example": "2026-11-04T09:00"
          },
          "interval": {
            "type": "integer",
            "example": 3600
          },
          "european_aqi": {
            "type": "number",
            "example": 42
          },
          "pm2_5": {
            "type": "number",
            "example": 12.1
          },
          "pm10": {
            "type": "number",
            "example": 18.4
          },
          "nitrogen_dioxide": {
            "type": "number",
            "example": 8.2
          },
          "ozone": {
            "type": "number",
            "example": 55.0
          },
          "sulphur_dioxide": {
            "type": "number",
            "example": 1.1
          },
          "uv_index": {
            "type": "number",
            "example": 4.2
          }
        },
        "additionalProperties": true
      },
      "hourly": {
        "type": "object",
        "properties": {
          "time": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "uv_index": {
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        },
        "additionalProperties": true
      },
      "results": {
        "$ref": "#/components/schemas/AirQualityResults"
      }
    },
    "additionalProperties": true
  },
  "WeatherRainnyDay": {
    "type": "object",
    "required": [
      "date",
      "rain_sum",
      "kind"
    ],
    "properties": {
      "date": {
        "type": "string",
        "format": "date",
        "example": "2026-10-29"
      },
      "rain_sum": {
        "type": "number",
        "example": 3.1
      },
      "kind": {
        "type": "string",
        "enum": [
          "past",
          "current",
          "future"
        ],
        "example": "current"
      }
    }
  },
  "WeatherRainny": {
    "type": "object",
    "required": [
      "location",
      "timezone",
      "as_of",
      "unit",
      "days"
    ],
    "properties": {
      "location": {
        "type": "object",
        "required": [
          "latitude",
          "longitude"
        ],
        "properties": {
          "latitude": {
            "type": "number",
            "example": 16.0544
          },
          "longitude": {
            "type": "number",
            "example": 108.2022
          }
        }
      },
      "timezone": {
        "type": "string",
        "example": "Asia/Bangkok"
      },
      "as_of": {
        "type": "string",
        "format": "date",
        "example": "2026-10-29"
      },
      "unit": {
        "type": "string",
        "example": "mm"
      },
      "days": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/WeatherRainnyDay"
        }
      }
    }
  }
}
