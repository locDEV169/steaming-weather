{
  "openapi": "3.0.3",
  "info": {
    "title": "Weather Forecast API",
    "description": "Backend API for retrieving the current, hourly, and daily Open-Meteo forecast for Da Nang.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/v1/weather": {
      "get": {
        "summary": "Get the current weather forecast",
        "description": "Fetches the configured forecast from Open-Meteo and returns the provider payload. API key auth is optional and only enforced when WEATHER_API_KEY is set.",
        "operationId": "getWeatherForecast",
        "tags": [
          "weather"
        ],
        "security": [
          {},
          {
            "ApiKeyAuth": []
          },
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Forecast retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WeatherForecast"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key when WEATHER_API_KEY is configured.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unhandled server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "The weather provider returned an error or an invalid response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "504": {
            "description": "The weather provider timed out.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/weather-rainny-forecast": {
      "get": {
        "summary": "Get daily rainfall series for charting",
        "description": "Returns past, current, and future daily rain_sum values for Da Nang. The server derives as_of in Asia/Bangkok; no query params are required. Each day includes kind: past, current, or future. API key auth is optional and only enforced when WEATHER_API_KEY is set.",
        "operationId": "getWeatherRainny",
        "tags": [
          "weather_related"
        ],
        "security": [
          {},
          {
            "ApiKeyAuth": []
          },
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Rainfall series retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WeatherRainny"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key when WEATHER_API_KEY is configured.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unhandled server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "The weather provider returned an error or an invalid response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "504": {
            "description": "The weather provider timed out.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/air-quality": {
      "get": {
        "summary": "Get current European AQI for Da Nang",
        "description": "Fetches current air quality from Open-Meteo Air Quality API and returns the provider payload plus additive results.overall (band from european_aqi) and results.summary (bilingual UI copy). When hourly or current uv_index is present, the hourly series is kept and results.uv is the WHO band for the current UV value. No US AQI, no per-pollutant assessment. Summary text is informational band copy for display, not clinical advice. API key auth is optional and only enforced when WEATHER_API_KEY is set.",
        "operationId": "getAirQuality",
        "tags": [
          "weather_related"
        ],
        "security": [
          {},
          {
            "ApiKeyAuth": []
          },
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Air quality retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AirQuality"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key when WEATHER_API_KEY is configured.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unhandled server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "The air quality provider returned an error or an invalid response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "504": {
            "description": "The air quality provider timed out.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/snapshots/{slug}": {
      "get": {
        "summary": "Get a persisted Supabase weather snapshot",
        "description": "Reads the latest weather_snapshots row for the configured location and returns its payload only (same shape as the matching live endpoint). Slug is weather | rainny | air-quality. Does not call Open-Meteo. Requires prior POST /api/v1/ingest. API key auth is optional when WEATHER_API_KEY is set.",
        "operationId": "getWeatherSnapshot",
        "tags": [
          "snapshots"
        ],
        "security": [
          {},
          {
            "ApiKeyAuth": []
          },
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "weather",
                "rainny",
                "air-quality"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Snapshot payload returned successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Invalid snapshot slug.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key when WEATHER_API_KEY is configured.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "No snapshot row for that kind/location.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Supabase read failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Supabase is not configured.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ingest": {
      "post": {
        "summary": "Ingest shaped snapshots into Supabase",
        "description": "Fetches Open-Meteo weather and air quality, shapes rainny and AQ results, and upserts latest-only rows into weather_snapshots. Requires WEATHER_API_KEY and Supabase service role env. Partial per-kind updates are allowed. Cron is not required.",
        "operationId": "postWeatherIngest",
        "tags": [
          "ingest"
        ],
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "At least one snapshot kind was updated.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "fetched_at",
                    "updated",
                    "results"
                  ],
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "example": true
                    },
                    "fetched_at": {
                      "type": "string",
                      "example": "2026-11-04T04:00:00+00:00"
                    },
                    "updated": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "example": [
                        "weather",
                        "rainny",
                        "air_quality"
                      ]
                    },
                    "results": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "No snapshot kinds were updated.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Ingest auth or Supabase is not configured.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/current-weather": {
      "get": {
        "summary": "Read the latest stored current weather",
        "description": "Reads the newest current_weather row for the configured location from Supabase (order by fetched_at desc). Returns id, location_key, fetched_at, and the stored payload (Open-Meteo current fields plus optional WMO evaluation). Does not call Open-Meteo, does not insert, and does not send Telegram. API key auth is optional and only enforced when WEATHER_API_KEY is set.",
        "operationId": "getCurrentWeather",
        "tags": [
          "current-weather"
        ],
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Latest stored current_weather row.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentWeatherStored"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "No current_weather row is stored yet.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Supabase read failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Supabase is not configured.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Fetch current weather, insert Supabase, notify Telegram",
        "description": "Fetches Open-Meteo current weather for Da Nang (user curl fields including cloud_cover), shapes the payload, attaches Key WMO evaluation when weather_code maps, inserts a new append-only current_weather row, then sends a Telegram message. Requires WEATHER_API_KEY, Supabase service role env, TELEGRAM_BOT_TOKEN, and TELEGRAM_CHAT_ID.",
        "operationId": "postCurrentWeather",
        "tags": [
          "current-weather"
        ],
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current weather was inserted and Telegram was notified.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentWeatherReportResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Upstream, Supabase write, or Telegram send failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "API key, Supabase, or Telegram is not configured.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "504": {
            "description": "Open-Meteo timed out.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/lifestyle-insights": {
      "get": {
        "summary": "Read the latest lifestyle context forecast",
        "description": "Reads the lifestyle_insights row with the greatest fetched_at. Laundry and car wash use the first 3 stored hours from as_of. A laundry hour with precipitation probability >= 40 or precipitation >= 0.2 mm has flag Nguy cơ ướt. laundry.score is 100 minus the mean of those three probabilities, null as 0. laundry.message is the matching catalog sentence. car_wash.mean is that same mean. When the mean is inside one level score_min and score_max, car_wash.message is that level message. A null score_min counts as 0. No workout score. Does not call Open-Meteo. API key auth is optional and only enforced when WEATHER_API_KEY is set.",
        "operationId": "getLifestyleInsight",
        "tags": [
          "lifestyle-insights"
        ],
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Latest stored lifestyle row, the first 3 hours from as_of, and the car-wash mean.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "fetched_at",
                    "laundry",
                    "car_wash"
                  ],
                  "properties": {
                    "id": {
                      "type": "integer"
                    },
                    "location_key": {
                      "type": "string"
                    },
                    "fetched_at": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "as_of": {
                      "type": "string"
                    },
                    "laundry": {
                      "type": "object",
                      "additionalProperties": true
                    },
                    "car_wash": {
                      "type": "object",
                      "additionalProperties": true,
                      "nullable": true
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "No lifestyle row is stored.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Supabase read failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Supabase is not configured.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Append one lifestyle context forecast",
        "description": "Fetches Open-Meteo and inserts one append-only row into lifestyle_insights. Hour labels on the new row are UTC. Each new hour stores apparent_temperature from that hour. The 72-hour series keeps provider wind in km/h. Current may also include apparent_temperature when the provider sends it. Does not write weather_snapshots and does not run snapshot ingest. Requires WEATHER_API_KEY and Supabase service role env.",
        "operationId": "postLifestyleInsight",
        "tags": [
          "lifestyle-insights"
        ],
        "security": [
          {
            "ApiKeyAuth": []
          },
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "201": {
            "description": "One lifestyle history row was inserted.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "ok",
                    "location_key",
                    "fetched_at",
                    "as_of",
                    "hours_returned"
                  ],
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "example": true
                    },
                    "id": {
                      "type": "integer",
                      "example": 1
                    },
                    "location_key": {
                      "type": "string",
                      "example": "da_nang"
                    },
                    "fetched_at": {
                      "type": "string",
                      "example": "2026-11-04T04:00:00+00:00"
                    },
                    "as_of": {
                      "type": "string",
                      "example": "2026-11-04T10:00"
                    },
                    "hours_returned": {
                      "type": "integer",
                      "example": 72
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Upstream or Supabase write failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "API key or Supabase is not configured.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "504": {
            "description": "Open-Meteo timed out.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      },
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "ApiErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "UNAUTHORIZED",
                  "NOT_FOUND",
                  "METHOD_NOT_ALLOWED",
                  "INTERNAL_ERROR",
                  "UPSTREAM_TIMEOUT",
                  "UPSTREAM_ERROR",
                  "INVALID_UPSTREAM_RESPONSE",
                  "INGEST_AUTH_REQUIRED",
                  "SUPABASE_NOT_CONFIGURED",
                  "INGEST_FAILED",
                  "SUPABASE_WRITE_ERROR",
                  "SUPABASE_READ_ERROR",
                  "CURRENT_WEATHER_NOT_FOUND",
                  "TELEGRAM_NOT_CONFIGURED",
                  "TELEGRAM_SEND_ERROR"
                ]
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "WeatherForecast": {
        "type": "object",
        "required": [
          "current",
          "hourly",
          "daily"
        ],
        "properties": {
          "latitude": {
            "type": "number",
            "example": 16.063269
          },
          "longitude": {
            "type": "number",
            "example": 108.23864
          },
          "timezone": {
            "type": "string",
            "example": "Asia/Bangkok"
          },
          "current": {
            "type": "object",
            "additionalProperties": true
          },
          "hourly": {
            "type": "object",
            "additionalProperties": true
          },
          "daily": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      },
      "AirQualityOverallResult": {
        "type": "object",
        "required": [
          "index",
          "band_code",
          "label_key"
        ],
        "properties": {
          "index": {
            "type": "number",
            "example": 32
          },
          "band_code": {
            "type": "string",
            "enum": [
              "good",
              "fair",
              "moderate",
              "poor",
              "very_poor",
              "extremely_poor"
            ],
            "example": "fair"
          },
          "label_key": {
            "type": "string",
            "example": "aqi.european.fair"
          }
        }
      },
      "AirQualitySummary": {
        "type": "object",
        "required": [
          "band_code",
          "level_vi",
          "level_en",
          "meaning_vi",
          "meaning_en"
        ],
        "properties": {
          "band_code": {
            "type": "string",
            "enum": [
              "good",
              "fair",
              "moderate",
              "poor",
              "very_poor",
              "extremely_poor"
            ],
            "example": "fair"
          },
          "level_vi": {
            "type": "string",
            "example": "Tốt"
          },
          "level_en": {
            "type": "string",
            "example": "Fair"
          },
          "meaning_vi": {
            "type": "string",
            "example": "Không khí sạch, an toàn cho đại đa số người dân."
          },
          "meaning_en": {
            "type": "string",
            "example": "Air is clean and safe for the vast majority of people."
          }
        }
      },
      "AirQualityResults": {
        "type": "object",
        "required": [
          "scale",
          "band_table_version",
          "source",
          "overall",
          "summary"
        ],
        "properties": {
          "scale": {
            "type": "string",
            "example": "european_aqi"
          },
          "band_table_version": {
            "type": "string",
            "example": "open-meteo-eea-2024"
          },
          "source": {
            "type": "string",
            "example": "https://open-meteo.com/en/docs/air-quality-api"
          },
          "overall": {
            "$ref": "#/components/schemas/AirQualityOverallResult"
          },
          "summary": {
            "$ref": "#/components/schemas/AirQualitySummary"
          },
          "uv": {
            "$ref": "#/components/schemas/UvIndexSummary"
          }
        }
      },
      "UvIndexSummary": {
        "type": "object",
        "description": "WHO global solar UV index band for the current hour. Omitted when uv_index is absent.",
        "required": [
          "index",
          "band_code",
          "level_vi",
          "level_en",
          "meaning_vi",
          "meaning_en"
        ],
        "properties": {
          "index": {
            "type": "number",
            "example": 4.2
          },
          "band_code": {
            "type": "string",
            "enum": [
              "low",
              "moderate",
              "high",
              "very_high",
              "extreme"
            ],
            "example": "moderate"
          },
          "level_vi": {
            "type": "string",
            "example": "Trung bình"
          },
          "level_en": {
            "type": "string",
            "example": "Moderate"
          },
          "meaning_vi": {
            "type": "string"
          },
          "meaning_en": {
            "type": "string"
          }
        }
      },
      "AirQuality": {
        "type": "object",
