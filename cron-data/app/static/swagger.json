              },
              "ozone": {
                "type": "number",
                "example": 55.0
              },
              "sulphur_dioxide": {
                "type": "number",
                "example": 1.1
              },
              "uv_index": {
                "type": "number",
                "example": 4.2
              }
            },
            "additionalProperties": true
          },
          "hourly": {
            "type": "object",
            "properties": {
              "time": {
                "type": "array",
